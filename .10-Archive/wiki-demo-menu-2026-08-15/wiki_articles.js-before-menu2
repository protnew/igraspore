window.WIKI_ART = {
  0:{ru:"Synechocystis \u2014 \u0441\u0438\u043d\u0435\u0437\u0435\u043b\u0451\u043d\u0430\u044f \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f \u0431\u0435\u0437 \u044f\u0434\u0440\u0430. \u0416\u0438\u0432\u0451\u0442 \u0437\u0430 \u0441\u0447\u0451\u0442 \u0441\u0432\u0435\u0442\u0430: \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043d\u044b\u0439 \u0444\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437 \u043d\u0430 \u043c\u0435\u043c\u0431\u0440\u0430\u043d\u0430\u0445, \u0431\u0435\u0437 \u0445\u043b\u043e\u0440\u043e\u043f\u043b\u0430\u0441\u0442\u043e\u0432. \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u043e\u0434\u043e\u0440\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0437\u043c\u0430.",en:"Synechocystis is a cyanobacterium with no nucleus. It lives on light: oxygenic photosynthesis on membranes, no chloroplasts. Lab model for hydrogen metabolism."},
  1:{ru:"Anabaena variabilis \u2014 \u043d\u0438\u0442\u044c \u043a\u043b\u0435\u0442\u043e\u043a. \u0427\u0430\u0441\u0442\u044c \u043a\u043b\u0435\u0442\u043e\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0433\u0435\u0442\u0435\u0440\u043e\u0446\u0438\u0441\u0442\u0430\u043c\u0438 \u0438 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442 \u0430\u0437\u043e\u0442 \u0438\u0437 \u0432\u043e\u0437\u0434\u0443\u0445\u0430, \u043f\u043e\u043a\u0430 \u0441\u043e\u0441\u0435\u0434\u0438 \u0434\u0435\u043b\u0430\u044e\u0442 \u0441\u0430\u0445\u0430\u0440. \u0412 \u043f\u0440\u0443\u0434\u0443 \u044d\u0442\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u0430\u0437\u043e\u0442\u0430.",en:"Anabaena variabilis is a filament. Some cells become heterocysts and fix nitrogen while neighbours make sugar. In the pond it supplies bound nitrogen."},
  2:{ru:"Spirulina (Arthrospira) \u2014 \u043f\u0440\u0443\u0436\u0438\u043d\u0430 \u0438\u0437 \u043a\u043b\u0435\u0442\u043e\u043a \u0441 \u0433\u0430\u0437\u043e\u0432\u044b\u043c\u0438 \u0432\u0430\u043a\u0443\u043e\u043b\u044f\u043c\u0438. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u0443 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438, \u0444\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437\u0438\u0440\u0443\u0435\u0442, \u0441\u044a\u0435\u0434\u043e\u0431\u043d\u0430. \u0412 \u0438\u0433\u0440\u0435 \u044d\u0442\u043e \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u0437\u0435\u043b\u0451\u043d\u044b\u0439 \u0432\u0438\u043d\u0442 \u0443 \u043f\u043b\u0451\u043d\u043a\u0438 \u0432\u043e\u0434\u044b.",en:"Spirulina (Arthrospira) is a coil of cells with gas vesicles. It hangs near the surface, photosynthesizes, and is edible. In-game it is a large green screw at the water film."},
  3:{ru:"Nostoc punctiforme \u2014 \u0431\u0443\u0441\u044b \u0432 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043a\u0430\u043f\u0441\u0443\u043b\u0435. \u0423\u043c\u0435\u0435\u0442 \u0436\u0438\u0442\u044c \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u0438 \u0432 \u0441\u0438\u043c\u0431\u0438\u043e\u0437\u0435 \u0441 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f\u043c\u0438. \u041a\u043e\u043b\u043e\u043d\u0438\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u043a\u043e\u043c\u043e\u043a \u0437\u0435\u043b\u0451\u043d\u044b\u0445 \u0431\u0443\u0441\u0438\u043d.",en:"Nostoc punctiforme is a bead chain in a slime capsule. It lives free or in plant symbiosis. The colony looks like a clump of green beads."},
  4:{ru:"Oscillatoria limnetica \u2014 \u0441\u043a\u043e\u043b\u044c\u0437\u044f\u0449\u0430\u044f \u043d\u0438\u0442\u044c. \u041a\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u0437 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443, \u0443\u043c\u0435\u0435\u0442 \u0444\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437 \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430. \u0422\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u044c \u0438\u043b\u0430 \u0438 \u043f\u043b\u0451\u043d\u043a\u0438.",en:"Oscillatoria limnetica is a gliding filament. It oscillates side to side and can photosynthesize without releasing oxygen. Typical of silt and surface film."},
  5:{ru:"Microcystis aeruginosa \u2014 \u043a\u043e\u043b\u043e\u043d\u0438\u044f \u0432 \u0441\u043b\u0438\u0437\u0438, \u0447\u0430\u0441\u0442\u043e \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u0430\u044f (\u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0441\u0442\u0438\u043d). \u0414\u0430\u0451\u0442 \u0446\u0432\u0435\u0442\u0435\u043d\u0438\u0435 \u0432\u043e\u0434\u044b. \u0412 \u0438\u0433\u0440\u0435 \u044d\u0442\u043e \u0437\u0435\u043b\u0451\u043d\u044b\u0439 \u0448\u0430\u0440-\u043a\u043e\u043b\u043e\u043d\u0438\u044f, \u043e\u043f\u0430\u0441\u043d\u044b\u0439 \u0434\u043b\u044f \u0435\u0434\u043e\u043a\u043e\u0432.",en:"Microcystis aeruginosa is a mucilage colony, often toxic (microcystin). It causes water bloom. In-game it is a green colony ball, risky prey."},
  6:{ru:"Gloeocapsa \u2014 \u043f\u0430\u0440\u044b \u043a\u043b\u0435\u0442\u043e\u043a \u0432 \u0446\u0432\u0435\u0442\u043d\u044b\u0445 \u0447\u0435\u0445\u043b\u0430\u0445. \u0416\u0438\u0432\u0451\u0442 \u043d\u0430 \u043a\u0430\u043c\u043d\u044f\u0445 \u0438 \u0432 \u043f\u043e\u0447\u0432\u0435, \u0445\u043e\u0440\u043e\u0448\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442 \u0443\u043b\u044c\u0442\u0440\u0430\u0444\u0438\u043e\u043b\u0435\u0442. \u0412 \u043f\u0440\u0443\u0434\u0443 \u044d\u0442\u043e \u043c\u0435\u043b\u043a\u0438\u0435 \u043f\u0430\u0440\u043d\u044b\u0435 \u043a\u043e\u043a\u043a\u0438 \u0432 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0435.",en:"Gloeocapsa is paired cells in colored sheaths. It lives on rocks and soil and tolerates UV. In the pond it is small paired cocci in a coat."},
  7:{ru:"Lyngbya majuscula \u2014 \u0442\u043e\u043b\u0441\u0442\u0430\u044f \u043d\u0438\u0442\u044c \u0446\u0438\u0430\u043d\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438. \u041c\u043e\u0436\u0435\u0442 \u0432\u044b\u0434\u0435\u043b\u044f\u0442\u044c \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044e\u0449\u0438\u0435 \u0442\u043e\u043a\u0441\u0438\u043d\u044b. \u041e\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043a\u043e\u0432\u0440\u044b \u0443 \u0431\u0435\u0440\u0435\u0433\u0430 \u0432 \u0442\u0451\u043f\u043b\u043e\u0439 \u0432\u043e\u0434\u0435.",en:"Lyngbya majuscula is a thick cyanobacterial filament. It can release irritating toxins. It forms mats near warm shores."},
  8:{ru:"Chlamydomonas reinhardtii \u2014 \u0437\u0435\u043b\u0451\u043d\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430 \u0441 \u0434\u0432\u0443\u043c\u044f \u0436\u0433\u0443\u0442\u0438\u043a\u0430\u043c\u0438 \u0438 \u0433\u043b\u0430\u0437\u043a\u043e\u043c. \u041f\u043b\u044b\u0432\u0451\u0442 \u043d\u0430 \u0441\u0432\u0435\u0442. \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438 \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u0435\u0439.",en:"Chlamydomonas reinhardtii is a green cell with two flagella and an eyespot. It swims toward light. Classic algal genetics model."},
  9:{ru:"Chlorella vulgaris \u2014 \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u044b\u0439 \u0437\u0435\u043b\u0451\u043d\u044b\u0439 \u0448\u0430\u0440. \u0411\u044b\u0441\u0442\u0440\u043e \u0434\u0435\u043b\u0438\u0442\u0441\u044f, \u043c\u043d\u043e\u0433\u043e \u0431\u0435\u043b\u043a\u0430. \u041a\u043e\u0440\u043c \u0434\u043b\u044f \u043c\u0435\u043b\u043a\u0438\u0445 \u0435\u0434\u043e\u043a\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u043e\u0432.",en:"Chlorella vulgaris is a non-motile green ball. It divides fast and is protein-rich. Food for small eaters and a space-food subject."},
  10:{ru:"Volvox globator \u2014 \u043f\u043e\u043b\u0430\u044f \u0441\u0444\u0435\u0440\u0430 \u0438\u0437 \u0442\u044b\u0441\u044f\u0447 \u043a\u043b\u0435\u0442\u043e\u043a. \u0414\u043e\u0447\u0435\u0440\u043d\u0438\u0435 \u043a\u043e\u043b\u043e\u043d\u0438\u0438 \u0437\u0440\u0435\u044e\u0442 \u0432\u043d\u0443\u0442\u0440\u0438 \u0438 \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u043d\u0430\u0440\u0443\u0436\u0443. \u0412 \u0438\u0433\u0440\u0435 \u044d\u0442\u043e \u043a\u0440\u0443\u043f\u043d\u0430\u044f \u0437\u0435\u043b\u0451\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u0438\u044f.",en:"Volvox globator is a hollow sphere of thousands of cells. Daughter colonies ripen inside and exit. In-game it is a large green colony."},
  11:{ru:"Euglena gracilis \u2014 \u043c\u0438\u043a\u0441\u043e\u0442\u0440\u043e\u0444: \u0435\u0441\u0442\u044c \u0445\u043b\u043e\u0440\u043e\u043f\u043b\u0430\u0441\u0442\u044b, \u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0438 \u0433\u043b\u043e\u0442\u0430\u0442\u044c \u043f\u0438\u0449\u0443. \u041a\u0440\u0430\u0441\u043d\u044b\u0439 \u0433\u043b\u0430\u0437\u043e\u043a \u043b\u043e\u0432\u0438\u0442 \u0441\u0432\u0435\u0442. \u0414\u043d\u0451\u043c \u0437\u0435\u043b\u0451\u043d\u0430\u044f, \u0432 \u0442\u0435\u043c\u043d\u043e\u0442\u0435 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0435\u0434\u0443.",en:"Euglena gracilis is a mixotroph: chloroplasts plus the ability to eat. A red eyespot tracks light. Green by day; in the dark it switches to food."},
  12:{ru:"Scenedesmus quadricauda \u2014 \u043e\u0431\u044b\u0447\u043d\u043e \u0447\u0435\u0442\u044b\u0440\u0435 \u043a\u043b\u0435\u0442\u043a\u0438 \u0432 \u0440\u044f\u0434 \u0441 \u0448\u0438\u043f\u0430\u043c\u0438 \u043f\u043e \u043a\u0440\u0430\u044f\u043c. \u0428\u0438\u043f\u044b \u043c\u0435\u0448\u0430\u044e\u0442 \u043f\u0440\u043e\u0433\u043b\u043e\u0442\u0438\u0442\u044c. \u041d\u0435 \u043f\u043b\u0430\u0432\u0430\u0435\u0442 \u2014 \u0434\u0440\u0435\u0439\u0444\u0443\u0435\u0442.",en:"Scenedesmus quadricauda is usually four cells in a row with end spines. Spines make swallowing harder. It does not swim \u2014 it drifts."},
  13:{ru:"Haematococcus pluvialis \u2014 \u0437\u0435\u043b\u0451\u043d\u0430\u044f \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430, \u043f\u0440\u0438 \u0441\u0442\u0440\u0435\u0441\u0441\u0435 \u043a\u0440\u0430\u0441\u043d\u0435\u0435\u0442 (\u0430\u0441\u0442\u0430\u043a\u0441\u0430\u043d\u0442\u0438\u043d) \u0438 \u043e\u0431\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u0441\u0442\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u043e\u0439. \u041a\u0440\u0430\u0441\u043d\u044b\u0435 \u0446\u0438\u0441\u0442\u044b \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044e\u0442 \u0437\u0430\u0441\u0443\u0445\u0443.",en:"Haematococcus pluvialis is a green motile cell; under stress it turns red (astaxanthin) and grows a thick wall. Red cysts survive drought."},
  14:{ru:"Dunaliella salina \u2014 \u0437\u0435\u043b\u0451\u043d\u0430\u044f \u0431\u0435\u0437 \u0436\u0451\u0441\u0442\u043a\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438, \u0436\u0438\u0432\u0451\u0442 \u0432 \u043e\u0447\u0435\u043d\u044c \u0441\u043e\u043b\u0451\u043d\u043e\u0439 \u0432\u043e\u0434\u0435. \u041a\u043e\u043f\u0438\u0442 \u0431\u0435\u0442\u0430-\u043a\u0430\u0440\u043e\u0442\u0438\u043d \u0438 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043e\u0440\u0430\u043d\u0436\u0435\u0432\u043e\u0439. \u0414\u0432\u0430 \u0436\u0433\u0443\u0442\u0438\u043a\u0430.",en:"Dunaliella salina has no rigid wall and lives in very salty water. It stores beta-carotene and looks orange. Two flagella."},
  15:{ru:"Micrasterias rotata \u2014 \u043f\u043b\u043e\u0441\u043a\u0430\u044f \u0437\u0432\u0435\u0437\u0434\u0430-\u0434\u0435\u0441\u043c\u0438\u0434\u0438\u044f. \u0414\u0432\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u0432\u044b\u0440\u0435\u0437\u044b. \u041d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430, \u0444\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437\u0438\u0440\u0443\u0435\u0442 \u0432 \u043a\u0438\u0441\u043b\u043e\u0439 \u0432\u043e\u0434\u0435 \u0431\u043e\u043b\u043e\u0442.",en:"Micrasterias rotata is a flat star desmid. Two mirrored halves with deep cuts. Non-motile; photosynthesizes in acidic bog water."},
  16:{ru:"Navicula \u2014 \u0434\u0438\u0430\u0442\u043e\u043c\u0435\u044f-\u043b\u043e\u0434\u043e\u0447\u043a\u0430 \u0441 \u043a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u043e\u0439 \u0441\u0442\u0432\u043e\u0440\u043a\u043e\u0439. \u041f\u043e\u043b\u0437\u0451\u0442 \u043f\u043e \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442\u0443 \u0432\u0434\u043e\u043b\u044c \u0449\u0435\u043b\u0438 (raphe). \u041f\u0430\u043d\u0446\u0438\u0440\u044c \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438.",en:"Navicula is a boat-shaped diatom with a silica valve. It glides on the substrate along a raphe slit. The shell remains after death."},
  17:{ru:"Pinnularia viridis \u2014 \u043a\u0440\u0443\u043f\u043d\u0430\u044f \u043f\u0435\u0440\u0438\u0441\u0442\u044b\u0439 \u0434\u0438\u0430\u0442\u043e\u043c\u0435\u044f. \u041a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u044b\u0439 \u043f\u0430\u043d\u0446\u0438\u0440\u044c \u0441 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u043c \u0443\u0437\u043e\u0440\u043e\u043c. \u041c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0441\u043a\u043e\u043b\u044c\u0437\u0438\u0442 \u043f\u043e \u0434\u043d\u0443.",en:"Pinnularia viridis is a large pennate diatom. Silica shell with a symmetric pattern. It glides slowly on the bottom."},
  18:{ru:"Cyclotella meneghiniana \u2014 \u043a\u0440\u0443\u0433\u043b\u0430\u044f \u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u0438\u0430\u0442\u043e\u043c\u0435\u044f. \u041f\u043b\u044b\u0432\u0451\u0442 \u043a\u0430\u043a \u0434\u0438\u0441\u043a, \u043f\u0430\u043d\u0446\u0438\u0440\u044c \u0438\u0437 \u0434\u0432\u0443\u0445 \u043a\u0440\u044b\u0448\u0435\u0447\u0435\u043a. \u0422\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u043f\u043b\u0430\u043d\u043a\u0442\u043e\u043d.",en:"Cyclotella meneghiniana is a circular centric diatom. It floats as a disc; the shell is two lids. Typical plankton."},
  19:{ru:"Diatoma vulgare \u2014 \u0434\u0438\u0430\u0442\u043e\u043c\u0435\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043a\u043b\u0435\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0437\u0438\u0433\u0437\u0430\u0433. \u041a\u043e\u043b\u043e\u043d\u0438\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u0430\u0440\u0443\u0441\u043d\u043e\u0441\u0442\u044c \u0432 \u0442\u043e\u043b\u0449\u0435 \u0432\u043e\u0434\u044b.",en:"Diatoma vulgare is a diatom that sticks into a zigzag. The colony increases drag in the water column."},
  20:{ru:"Rhodospirillum rubrum \u2014 \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u0430\u044f \u0441\u043f\u0438\u0440\u0430\u043b\u044c. \u0424\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437 \u0431\u0435\u0437 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u043e\u0440\u0433\u0430\u043d\u0438\u043a\u0443. \u041a\u0440\u0430\u0441\u043d\u044b\u0439 \u0446\u0432\u0435\u0442 \u2014 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0445\u043b\u043e\u0440\u043e\u0444\u0438\u043b\u043b.",en:"Rhodospirillum rubrum is a purple spiral. Anoxygenic photosynthesis plus organics. Red color comes from bacteriochlorophyll."},
  21:{ru:"Chromatium vinosum \u2014 \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u0430\u044f \u0441\u0435\u0440\u043d\u0430\u044f \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f. \u041e\u043a\u0438\u0441\u043b\u044f\u0435\u0442 \u0441\u0435\u0440\u043e\u0432\u043e\u0434\u043e\u0440\u043e\u0434 \u0438 \u043a\u043e\u043f\u0438\u0442 \u0433\u0440\u0430\u043d\u0443\u043b\u044b \u0441\u0435\u0440\u044b \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u043b\u0435\u0442\u043a\u0438. \u0416\u0438\u0432\u0451\u0442 \u0443 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434/\u0441\u0435\u0440\u0430.",en:"Chromatium vinosum is a purple sulfur bacterium. It oxidizes hydrogen sulfide and stores sulfur granules. Lives at the oxygen/sulfur boundary."},
  22:{ru:"Porphyridium cruentum \u2014 \u043e\u0434\u043d\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u043d\u0430\u044f \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u044c. \u0424\u0438\u043a\u043e\u044d\u0440\u0438\u0442\u0440\u0438\u043d \u0434\u0430\u0451\u0442 \u043a\u0440\u043e\u0432\u0430\u0432\u044b\u0439 \u0446\u0432\u0435\u0442. \u0421\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0439 \u0447\u0435\u0445\u043e\u043b, \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u0432 \u043d\u0435\u0442.",en:"Porphyridium cruentum is a unicellular red alga. Phycoerythrin gives a blood-red color. Mucilage coat, no flagella."},
  23:{ru:"Prochlorococcus marinus \u2014 \u0441\u0430\u043c\u0430\u044f \u043c\u0435\u043b\u043a\u0430\u044f \u0438 \u0441\u0430\u043c\u0430\u044f \u043c\u0430\u0441\u0441\u043e\u0432\u0430\u044f \u0444\u043e\u0442\u043e\u0441\u0438\u043d\u0442\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430 \u043d\u0430 \u0417\u0435\u043c\u043b\u0435. \u041e\u0442\u043a\u0440\u044b\u0442\u0430 \u0432 1980-\u0445. \u041a\u043e\u0440\u043c\u0438\u0442 \u043e\u043a\u0435\u0430\u043d.",en:"Prochlorococcus marinus is the smallest and most abundant photosynthetic cell on Earth. Discovered in the 1980s. It feeds the ocean."},
  24:{ru:"Chroococcidiopsis thermalis \u2014 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b: \u043f\u0443\u0441\u0442\u044b\u043d\u044f, \u043a\u0430\u043c\u0435\u043d\u044c, \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u044f. \u041a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043d\u0430 \u0436\u0438\u0437\u043d\u044c \u0432\u043d\u0435 \u0417\u0435\u043c\u043b\u0438. \u0412 \u043f\u0440\u0443\u0434\u0443 \u2014 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u0438\u044f-\u043a\u043e\u043a\u043a.",en:"Chroococcidiopsis thermalis is an extremophile: desert, rock, radiation. A candidate for life beyond Earth. In the pond it is a slow coccus colony."},
  25:{ru:"Bdellovibrio bacteriovorus \u2014 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0439 \u0445\u0438\u0449\u043d\u0438\u043a \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439. \u0412\u0432\u0438\u043d\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0447\u0443\u0436\u0443\u044e \u043a\u043b\u0435\u0442\u043a\u0443 \u0438 \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0430\u0435\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438, \u043f\u043e\u043a\u0430 \u0445\u043e\u0437\u044f\u0438\u043d \u043d\u0435 \u043b\u043e\u043f\u043d\u0435\u0442.",en:"Bdellovibrio bacteriovorus is a tiny bacterial predator. It screws into another cell and multiplies until the host bursts."},
  26:{ru:"Vampirococcus \u2014 \u0441\u0430\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0436\u0435\u0440\u0442\u0432\u0443 \u0441\u043d\u0430\u0440\u0443\u0436\u0438 \u0438 \u0432\u044b\u0441\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435, \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u044f \u0432\u043d\u0443\u0442\u0440\u044c. \u00ab\u0412\u0430\u043c\u043f\u0438\u0440\u00bb \u0441\u0440\u0435\u0434\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Vampirococcus sits on prey from the outside and sucks out the contents without entering. A bacterial vampire."},
  27:{ru:"Daptobacter \u2014 \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u0435\u0442 \u0432\u043d\u0443\u0442\u0440\u044c \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438-\u0436\u0435\u0440\u0442\u0432\u044b \u0438 \u0435\u0441\u0442 \u0435\u0451 \u0438\u0437\u043d\u0443\u0442\u0440\u0438. \u0420\u0435\u0434\u043a\u0438\u0439 \u0432\u043d\u0443\u0442\u0440\u0438\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a.",en:"Daptobacter enters a prey bacterium and eats it from inside. A rare intracellular hunter."},
  28:{ru:"Myxococcus xanthus \u2014 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f. \u0421\u0442\u0430\u0435\u0439 \u043e\u043a\u0440\u0443\u0436\u0430\u0435\u0442 \u0434\u043e\u0431\u044b\u0447\u0443 \u0438 \u0432\u044b\u0434\u0435\u043b\u044f\u0435\u0442 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b. \u041f\u0440\u0438 \u0433\u043e\u043b\u043e\u0434\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u043e\u0434\u043e\u0432\u043e\u0435 \u0442\u0435\u043b\u043e.",en:"Myxococcus xanthus is a social bacterium. In a pack it surrounds prey and releases enzymes. When starved it forms a fruiting body."},
  29:{ru:"Bacteriovorax stolpii \u2014 \u043c\u043e\u0440\u0441\u043a\u043e\u0439 \u0440\u043e\u0434\u0438\u0447 \u0431\u0434\u0435\u043b\u043b\u043e\u0432\u0438\u0431\u0440\u0438\u043e. \u0410\u0442\u0430\u043a\u0443\u0435\u0442 \u0433\u0440\u0430\u043c\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445, \u0436\u0438\u0432\u0451\u0442 \u0432 periplasm \u0436\u0435\u0440\u0442\u0432\u044b.",en:"Bacteriovorax stolpii is a marine Bdellovibrio relative. It attacks Gram-negatives and lives in the prey periplasm."},
  30:{ru:"Halobacteriovorax \u2014 \u0441\u043e\u043b\u0435\u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a \u043d\u0430 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439. \u0422\u043e\u0442 \u0436\u0435 \u043f\u0440\u0438\u0451\u043c: \u043f\u0440\u043e\u043a\u043e\u043b \u0441\u0442\u0435\u043d\u043a\u0438 \u0438 \u0440\u043e\u0441\u0442 \u0432\u043d\u0443\u0442\u0440\u0438.",en:"Halobacteriovorax is a salt-tolerant bacterial hunter. Same trick: puncture the wall and grow inside."},
  31:{ru:"Peredibacter starrii \u2014 \u0435\u0449\u0451 \u043e\u0434\u0438\u043d BALO-\u0445\u0438\u0449\u043d\u0438\u043a. \u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0437\u0430\u043f\u044f\u0442\u0430\u044f-\u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446, \u0446\u0435\u043b\u044c \u2014 \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u043f\u0430\u043b\u043e\u0447\u043a\u0438.",en:"Peredibacter starrii is another BALO predator. A fast comma-shaped flagellate targeting large rods."},
  32:{ru:"Monas guttula \u2014 \u043c\u0435\u043b\u043a\u0438\u0439 \u0433\u0435\u0442\u0435\u0440\u043e\u0442\u0440\u043e\u0444\u043d\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446. \u0425\u0432\u0430\u0442\u0430\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0443 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0434\u0435\u0442\u0440\u0438\u0442\u0430.",en:"Monas guttula is a small heterotrophic flagellate. It grabs bacteria at the detritus surface."},
  33:{ru:"Oikomonas termo \u2014 \u043a\u0430\u043f\u043b\u0435\u0432\u0438\u0434\u043d\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446. \u041e\u0434\u0438\u043d \u0436\u0433\u0443\u0442\u0438\u043a, \u043e\u0445\u043e\u0442\u0438\u0442\u0441\u044f \u0432 \u043f\u043b\u0451\u043d\u043a\u0435 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Oikomonas termo is a drop-shaped flagellate. One flagellum; it hunts in bacterial film."},
  34:{ru:"Anthophysa vegetans \u2014 \u043a\u043e\u043b\u043e\u043d\u0438\u044f \u043d\u0430 \u043d\u043e\u0436\u043a\u0435 \u0438\u0437 \u0436\u0435\u043b\u0435\u0437\u0430 \u0438 \u043c\u0430\u0440\u0433\u0430\u043d\u0446\u0430. \u041a\u043b\u0435\u0442\u043a\u0438 \u0441\u0438\u0434\u044f\u0442 \u043f\u0443\u0447\u043a\u043e\u043c \u0438 \u043b\u043e\u0432\u044f\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Anthophysa vegetans is a colony on an iron-manganese stalk. Cells sit in a tuft and catch bacteria."},
  35:{ru:"Chilomonas paramecium \u2014 \u0431\u0435\u0441\u0446\u0432\u0435\u0442\u043d\u044b\u0439 \u043a\u0440\u0438\u043f\u0442\u043e\u0444\u0438\u0442. \u0414\u0432\u0430 \u0436\u0433\u0443\u0442\u0438\u043a\u0430, \u0435\u0441\u0442 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0451\u043d\u043d\u0443\u044e \u043e\u0440\u0433\u0430\u043d\u0438\u043a\u0443 \u0438 \u043c\u0435\u043b\u043a\u0438\u0445 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439, \u0445\u043b\u043e\u0440\u043e\u043f\u043b\u0430\u0441\u0442\u043e\u0432 \u043d\u0435\u0442.",en:"Chilomonas paramecium is a colorless cryptophyte. Two flagella; it eats dissolved organics and tiny bacteria, no chloroplasts."},
  36:{ru:"Cercomonas longicauda \u2014 \u0430\u043c\u0451\u0431\u043e-\u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446 \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c \u0445\u0432\u043e\u0441\u0442\u043e\u043c. \u041f\u043e\u043b\u0437\u0451\u0442 \u0438 \u0437\u0430\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u043f\u0441\u0435\u0432\u0434\u043e\u043f\u043e\u0434\u0438\u044f\u043c\u0438.",en:"Cercomonas longicauda is an amoeboflagellate with a long tail. It crawls and swallows bacteria with pseudopodia."},
  37:{ru:"Heteromita globosa \u2014 \u043f\u043e\u0447\u0432\u0435\u043d\u043d\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446. \u0414\u0432\u0430 \u0436\u0433\u0443\u0442\u0438\u043a\u0430 \u0440\u0430\u0437\u043d\u043e\u0439 \u0434\u043b\u0438\u043d\u044b, \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0435\u0434\u043e\u043a \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0432 \u043f\u043e\u0447\u0432\u0435.",en:"Heteromita globosa is a soil flagellate. Two flagella of different length; a main bacterial eater in soil."},
  38:{ru:"Bodo saltans \u2014 \u043a\u0438\u043d\u0435\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0434\u0430. \u00ab\u041f\u043b\u044f\u0448\u0435\u0442\u00bb \u043d\u0430 \u043c\u0435\u0441\u0442\u0435, \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u044f\u044f\u0441\u044c \u0437\u0430\u0434\u043d\u0438\u043c \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043c, \u0438 \u0432\u044b\u043b\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Bodo saltans is a kinetoplastid. It 'dances' in place, attached by the rear flagellum, and snatches bacteria."},
  39:{ru:"Procryptobia sorokini \u2014 \u0440\u043e\u0434\u0438\u0447 \u0431\u043e\u0434\u043e. \u0421\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u043f\u043b\u0430\u0432\u0430\u0435\u0442, \u0431\u044c\u0451\u0442 \u0436\u0435\u0440\u0442\u0432\u0443 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u043c \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043c.",en:"Procryptobia sorokini is a Bodo relative. It swims freely and strikes prey with the anterior flagellum."},
  40:{ru:"Trypanosoma brucei \u2014 \u043f\u0430\u0440\u0430\u0437\u0438\u0442 \u043a\u0440\u043e\u0432\u0438, \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044c \u0441\u043e\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0412\u043e\u043b\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f \u043c\u0435\u043c\u0431\u0440\u0430\u043d\u0430 \u0438 \u043e\u0434\u0438\u043d \u0436\u0433\u0443\u0442\u0438\u043a. \u0412 \u043f\u0440\u0443\u0434\u0443 \u2014 \u043c\u043e\u0434\u0435\u043b\u044c \u0443\u0437\u043a\u043e\u0433\u043e \u043e\u0445\u043e\u0442\u043d\u0438\u043a\u0430.",en:"Trypanosoma brucei is a blood parasite causing sleeping sickness. Undulating membrane and one flagellum. In the pond it is a slim-hunter model."},
  41:{ru:"Leishmania donovani \u2014 \u0432\u043d\u0443\u0442\u0440\u0438\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u0437\u0438\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0416\u0433\u0443\u0442\u0438\u043a\u043e\u0432\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0432 \u043d\u0430\u0441\u0435\u043a\u043e\u043c\u043e\u043c, \u0431\u0435\u0437\u0436\u0433\u0443\u0442\u0438\u043a\u043e\u0432\u0430\u044f \u0432 \u043c\u0430\u043a\u0440\u043e\u0444\u0430\u0433\u0435.",en:"Leishmania donovani is an intracellular human parasite. Flagellated in the insect, aflagellate inside a macrophage."},
  42:{ru:"Monosiga brevicollis \u2014 \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0447\u043a\u043e\u0432\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446, \u0440\u043e\u0434\u0438\u0447 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445. \u0412\u043e\u0440\u043e\u0442\u043d\u0438\u043a \u0438\u0437 \u043c\u0438\u043a\u0440\u043e\u0432\u043e\u0440\u0441\u0438\u043d\u043e\u043a \u0444\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Monosiga brevicollis is a choanoflagellate, an animal relative. A microvilli collar filters bacteria."},
  43:{ru:"Salpingoeca rosetta \u2014 \u0441\u0438\u0434\u044f\u0447\u0438\u0439 \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0447\u043a\u043e\u0432\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043d\u043e\u0441\u0435\u0446 \u0432 \u0434\u043e\u043c\u0438\u043a\u0435. \u041c\u043e\u0436\u0435\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c\u0441\u044f \u0432 \u0440\u043e\u0437\u0435\u0442\u043a\u0443. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0442\u043e\u043a \u0432\u043e\u0434\u044b.",en:"Salpingoeca rosetta is a sessile choanoflagellate in a lorica. It can form a rosette. It filters a water current."},
  44:{ru:"Codonosiga botrytis \u2014 \u043a\u043e\u043b\u043e\u043d\u0438\u044f \u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0447\u043a\u043e\u0432\u044b\u0445 \u043d\u0430 \u043e\u0431\u0449\u0435\u0439 \u043d\u043e\u0436\u043a\u0435. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432 \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u0441\u0442\u0435\u0431\u043b\u0435.",en:"Codonosiga botrytis is a choanoflagellate colony on a shared stalk. Several filters on one stem."},
  45:{ru:"Paramecium caudatum \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0443\u0444\u0435\u043b\u044c\u043a\u0430. \u0422\u044b\u0441\u044f\u0447\u0438 \u0440\u0435\u0441\u043d\u0438\u0447\u0435\u043a, \u0440\u043e\u0442\u043e\u0432\u0430\u044f \u0432\u043e\u0440\u043e\u043d\u043a\u0430, \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0432\u0430\u043a\u0443\u043e\u043b\u0438. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Paramecium caudatum is the classic slipper. Thousands of cilia, an oral groove, contractile vacuoles. It filters bacteria."},
  46:{ru:"Paramecium bursaria \u2014 \u0442\u0443\u0444\u0435\u043b\u044c\u043a\u0430 \u0441 \u0441\u0438\u043c\u0431\u0438\u043e\u043d\u0442\u0430\u043c\u0438-\u0437\u043e\u043e\u0445\u043b\u043e\u0440\u0435\u043b\u043b\u0430\u043c\u0438. \u0417\u0435\u043b\u0451\u043d\u0430\u044f \u0438\u0437\u043d\u0443\u0442\u0440\u0438: \u0434\u043d\u0451\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u0430\u0445\u0430\u0440 \u043e\u0442 \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u0435\u0439, \u043d\u043e\u0447\u044c\u044e \u0444\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442.",en:"Paramecium bursaria is a slipper with zoochlorella symbionts. Green inside: sugar from algae by day, filtering at night."},
  47:{ru:"Stentor coeruleus \u2014 \u0441\u0438\u043d\u044f\u044f \u0442\u0440\u0443\u0431\u0430 \u0434\u043e \u043c\u0438\u043b\u043b\u0438\u043c\u0435\u0442\u0440\u0430. \u0420\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0432\u043e\u0440\u043e\u043d\u043a\u0443 \u0438 \u0433\u043e\u043d\u0438\u0442 \u0442\u043e\u043a \u0440\u0435\u0441\u043d\u0438\u0447\u043a\u0430\u043c\u0438. \u0423\u043c\u0435\u0435\u0442 \u043f\u043b\u0430\u0432\u0430\u0442\u044c \u0438 \u0441\u0438\u0434\u0435\u0442\u044c.",en:"Stentor coeruleus is a blue trumpet up to a millimetre. It flares into a funnel and drives a current with cilia. It can swim or sit."},
  48:{ru:"Stentor polymorphus \u2014 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u0441\u0438\u043d\u0435\u0433\u043e \u0441\u0442\u0435\u043d\u0442\u043e\u0440\u0430, \u0447\u0430\u0441\u0442\u043e \u0441 \u0437\u043e\u043e\u0445\u043b\u043e\u0440\u0435\u043b\u043b\u0430\u043c\u0438. \u041c\u0435\u043d\u044f\u0435\u0442 \u0444\u043e\u0440\u043c\u0443 \u043e\u0442 \u0442\u0440\u0443\u0431\u044b \u0434\u043e \u0448\u0430\u0440\u0430.",en:"Stentor polymorphus is a relative of the blue stentor, often with zoochlorellae. Shape shifts from trumpet to ball."},
  49:{ru:"Vorticella campanula \u2014 \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u0447\u0438\u043a \u043d\u0430 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043c\u043e\u043c \u0441\u0442\u0435\u0431\u0435\u043b\u044c\u043a\u0435. \u0421\u0442\u0435\u0431\u0435\u043b\u0451\u043a \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0441\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u0438\u0440\u0430\u043b\u044c\u044e. \u0421\u0430\u043c\u0430 \u043a\u043b\u0435\u0442\u043a\u0430 \u043d\u0435 \u0443\u043f\u043b\u044b\u0432\u0430\u0435\u0442.",en:"Vorticella campanula is a bell on a contractile stalk. The stalk coils into a spiral instantly. The cell itself does not swim away."},
  50:{ru:"Vorticella microstoma \u2014 \u043c\u0435\u043b\u043a\u0438\u0439 \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u0447\u0438\u043a. \u0422\u043e\u0442 \u0436\u0435 \u0441\u0442\u0435\u0431\u0435\u043b\u0451\u043a-\u043f\u0440\u0443\u0436\u0438\u043d\u0430, \u0443\u0436\u0435 \u0440\u043e\u0442\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u0435. \u0427\u0430\u0441\u0442\u043e \u043d\u0430 \u0434\u0435\u0442\u0440\u0438\u0442\u0435.",en:"Vorticella microstoma is a small bell. Same spring-stalk, a narrower oral field. Often on detritus."},
  51:{ru:"Didinium nasutum \u2014 \u0431\u043e\u0447\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a \u043d\u0430 \u0442\u0443\u0444\u0435\u043b\u0435\u043a. \u0412\u044b\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u0440\u0438\u0445\u043e\u0446\u0438\u0441\u0442\u044b, \u0433\u043b\u043e\u0442\u0430\u0435\u0442 \u0436\u0435\u0440\u0442\u0432\u0443 \u0446\u0435\u043b\u0438\u043a\u043e\u043c, \u0445\u043e\u0442\u044f \u043e\u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0435\u0433\u043e.",en:"Didinium nasutum is a barrel hunter of slippers. It fires toxicysts and swallows prey whole, even if the prey is larger."},
  52:{ru:"Spirostomum ambiguum \u2014 \u043e\u0447\u0435\u043d\u044c \u0434\u043b\u0438\u043d\u043d\u0430\u044f \u0441\u0438\u0433\u0430\u0440\u0430. \u0421\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u044b \u0437\u0430 \u0434\u043e\u043b\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u044b. \u0420\u0435\u0441\u043d\u0438\u0447\u043a\u0438 \u043f\u043e \u0441\u043f\u0438\u0440\u0430\u043b\u0438.",en:"Spirostomum ambiguum is a very long cigar. It contracts several-fold in a fraction of a second. Cilia run in a spiral."},
  53:{ru:"Blepharisma americanum \u2014 \u0440\u043e\u0437\u043e\u0432\u0430\u044f \u0438\u043d\u0444\u0443\u0437\u043e\u0440\u0438\u044f. \u041f\u0438\u0433\u043c\u0435\u043d\u0442 \u0431\u043b\u0435\u0444\u0430\u0440\u0438\u0437\u043c\u0438\u043d \u0441\u0432\u0435\u0442\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u0435\u043d. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0438 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u043f\u0430\u0434\u0430\u0442\u044c \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u043c\u0435\u043b\u043a\u0438\u0445.",en:"Blepharisma americanum is a pink ciliate. Blepharismin pigment is light-sensitive. It filters and can attack smaller cells."},
  54:{ru:"Euplotes patella \u2014 \u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0446\u0438\u0440\u0440\u0430\u0445, \u043a\u0430\u043a \u043d\u0430 \u043d\u043e\u0436\u043a\u0430\u0445. \u041f\u043b\u043e\u0441\u043a\u0438\u0439, \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0440\u0430\u0437\u0432\u043e\u0440\u043e\u0442. \u0421\u043e\u0441\u043a\u0440\u0435\u0431\u0430\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0441 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0435\u0439.",en:"Euplotes patella walks on cirri as if on legs. Flat, quick turns. It scrapes bacteria off surfaces."},
  55:{ru:"Stylonychia pustulata \u2014 \u0431\u0440\u044e\u0445\u043e\u0440\u0435\u0441\u043d\u0438\u0447\u043d\u0430\u044f, \u00ab\u0431\u0435\u0433\u0430\u0435\u0442\u00bb \u043f\u043e \u0434\u043d\u0443. \u041a\u0440\u0443\u043f\u043d\u044b\u0435 \u0446\u0438\u0440\u0440\u044b, \u0445\u043e\u0440\u043e\u0448\u043e \u0432\u0438\u0434\u0435\u043d \u0440\u043e\u0442. \u0425\u0438\u0449\u043d\u0438\u043a \u043c\u0435\u043b\u043a\u0438\u0445 \u0438\u043d\u0444\u0443\u0437\u043e\u0440\u0438\u0439.",en:"Stylonychia pustulata is a hypotrich that 'runs' on the bottom. Large cirri, a clear mouth. Predator of small ciliates."},
  56:{ru:"Oxytricha trifallax \u2014 \u043c\u043e\u0434\u0435\u043b\u044c \u0433\u0435\u043d\u043e\u043c\u0430: \u0443 \u043d\u0435\u0451 \u0434\u0432\u0430 \u044f\u0434\u0440\u0430 \u0438 \u0441\u043b\u043e\u0436\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0414\u041d\u041a. \u0425\u043e\u0434\u0438\u0442 \u043d\u0430 \u0446\u0438\u0440\u0440\u0430\u0445, \u0435\u0441\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0438 \u043c\u0435\u043b\u043a\u0438\u0445 \u043f\u0440\u043e\u0442\u0438\u0441\u0442\u043e\u0432.",en:"Oxytricha trifallax is a genome model: two nuclei and complex DNA rewriting. It walks on cirri and eats bacteria and small protists."},
  57:{ru:"Tetrahymena thermophila \u2014 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0438\u043d\u0444\u0443\u0437\u043e\u0440\u0438\u044f. \u0427\u0435\u0442\u044b\u0440\u0435 \u043c\u0435\u043c\u0431\u0440\u0430\u043d\u0435\u043b\u043b\u044b \u0443 \u0440\u0442\u0430, \u0431\u044b\u0441\u0442\u0440\u043e \u0434\u0435\u043b\u0438\u0442\u0441\u044f. \u041c\u043e\u0434\u0435\u043b\u044c \u0442\u0435\u043b\u043e\u043c\u0435\u0440 \u0438 \u0440\u0435\u0441\u043d\u0438\u0447\u0435\u043a.",en:"Tetrahymena thermophila is a lab ciliate. Four oral membranelles, fast division. Model for telomeres and cilia."},
  58:{ru:"Coleps hirtus \u2014 \u0431\u043e\u0447\u043e\u043d\u043e\u043a \u0432 \u0438\u0437\u0432\u0435\u0441\u0442\u043a\u043e\u0432\u044b\u0445 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430\u0445 \u0441 \u0448\u0438\u043f\u0430\u043c\u0438. \u041f\u0430\u0434\u0430\u043b\u044c\u0449\u0438\u043a \u0438 \u0445\u0438\u0449\u043d\u0438\u043a: \u0432\u0433\u0440\u044b\u0437\u0430\u0435\u0442\u0441\u044f \u0432 \u0440\u0430\u043d\u0435\u043d\u044b\u0445.",en:"Coleps hirtus is a barrel in calcareous plates with spines. Scavenger and predator: it bites into the wounded."},
  59:{ru:"Litonotus lamella \u2014 \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0445\u0438\u0449\u043d\u0438\u043a \u0441 \u0442\u043e\u043a\u0441\u0438\u0446\u0438\u0441\u0442\u0430\u043c\u0438 \u0432 \u00ab\u0445\u043e\u0431\u043e\u0442\u043a\u0435\u00bb. \u041f\u0430\u0440\u0430\u043b\u0438\u0437\u0443\u0435\u0442 \u0436\u0435\u0440\u0442\u0432\u0443 \u0438 \u0432\u044b\u0441\u0430\u0441\u044b\u0432\u0430\u0435\u0442.",en:"Litonotus lamella is a flat predator with toxicysts in a 'proboscis'. It paralyzes prey and sucks it out."},
  60:{ru:"Dileptus anser \u2014 \u0434\u043b\u0438\u043d\u043d\u0430\u044f \u0448\u0435\u044f \u0441 \u044f\u0434\u043e\u0432\u0438\u0442\u044b\u043c\u0438 \u044d\u043a\u0441\u0442\u0440\u0430\u0441\u043e\u043c\u0430\u043c\u0438. \u0411\u044c\u0451\u0442 \u0436\u0435\u0440\u0442\u0432\u0443 \u0448\u0435\u0435\u0439, \u0437\u0430\u0442\u0435\u043c \u0437\u0430\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u0435\u0442. \u041a\u0440\u0443\u043f\u043d\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0437\u0432\u0435\u043d\u0430.",en:"Dileptus anser has a long neck with venomous extrusomes. It strikes with the neck, then swallows. A large mid-tier hunter."},
  61:{ru:"Urocentrum turbo \u2014 \u0432\u043e\u043b\u0447\u043e\u043a: \u044d\u043a\u0432\u0430\u0442\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u044f\u0441 \u0440\u0435\u0441\u043d\u0438\u0447\u0435\u043a \u043a\u0440\u0443\u0442\u0438\u0442 \u043a\u043b\u0435\u0442\u043a\u0443 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Urocentrum turbo is a spinning top: an equatorial ciliary belt spins the cell in place. It filters bacteria."},
  62:{ru:"Zoothamnium arbuscula \u2014 \u0432\u0435\u0442\u0432\u0438\u0441\u0442\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u0438\u044f \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u044c\u0447\u0438\u043a\u043e\u0432. \u041e\u0431\u0449\u0438\u0439 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043c\u044b\u0439 \u0441\u0442\u0435\u0431\u0435\u043b\u044c \u0434\u0451\u0440\u0433\u0430\u0435\u0442 \u0432\u0441\u0451 \u0434\u0435\u0440\u0435\u0432\u043e \u0441\u0440\u0430\u0437\u0443.",en:"Zoothamnium arbuscula is a branched colony of bells. A shared contractile stalk jerks the whole tree at once."},
  63:{ru:"Opercularia coarctata \u2014 \u0441\u0438\u0434\u044f\u0447\u0430\u044f \u043f\u0435\u0440\u0438\u0442\u0440\u0438\u0445\u0430 \u0431\u0435\u0437 \u043f\u0440\u0443\u0436\u0438\u043d\u044b \u0432 \u0441\u0442\u0435\u0431\u043b\u0435. \u041a\u0440\u044b\u0448\u0435\u0447\u043a\u0430 \u043f\u0440\u0438\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0440\u043e\u0442. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442, \u043d\u0435 \u0443\u043f\u043b\u044b\u0432\u0430\u0435\u0442.",en:"Opercularia coarctata is a sessile peritrich without a spring stalk. A lid covers the mouth. It filters and does not swim away."},
  64:{ru:"Amoeba proteus \u2014 \u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043c\u0451\u0431\u0430. \u041b\u043e\u0436\u043d\u043e\u043d\u043e\u0436\u043a\u0438 \u043e\u0431\u0442\u0435\u043a\u0430\u044e\u0442 \u0434\u043e\u0431\u044b\u0447\u0443. \u041d\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b, \u043d\u0435\u0442 \u0440\u0435\u0441\u043d\u0438\u0447\u0435\u043a.",en:"Amoeba proteus is the classic amoeba. Pseudopodia flow around prey. No fixed shape, no cilia."},
  65:{ru:"Arcella vulgaris \u2014 \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u043d\u0430\u044f \u0430\u043c\u0451\u0431\u0430 \u0441 \u0436\u0451\u0441\u0442\u043a\u0438\u043c \u043a\u0443\u043f\u043e\u043b\u043e\u043c. \u041b\u043e\u0436\u043d\u043e\u043d\u043e\u0436\u043a\u0438 \u0432\u044b\u0441\u043e\u0432\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0438\u0437 \u0443\u0441\u0442\u044c\u044f. \u041f\u043e\u043b\u0437\u0451\u0442 \u043f\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f\u043c.",en:"Arcella vulgaris is a testate amoeba with a rigid dome. Pseudopodia emerge from the aperture. It crawls on plants."},
  66:{ru:"Difflugia oblonga \u2014 \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u043a\u0430 \u0438\u0437 \u043f\u0435\u0441\u0447\u0438\u043d\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0430\u043c\u0451\u0431\u0430 \u0441\u0430\u043c\u0430 \u043d\u0430\u043a\u043b\u0435\u0438\u0432\u0430\u0435\u0442. \u0416\u0438\u0432\u0451\u0442 \u0432 \u0438\u043b\u0435.",en:"Difflugia oblonga has a shell of sand grains the amoeba glues itself. It lives in silt."},
  67:{ru:"Euglypha alveolata \u2014 \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u043a\u0430 \u0438\u0437 \u043a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u044b\u0445 \u0447\u0435\u0448\u0443\u0435\u043a. \u0422\u043e\u043d\u043a\u0438\u0435 \u043d\u0438\u0442\u0435\u0432\u0438\u0434\u043d\u044b\u0435 \u043b\u043e\u0436\u043d\u043e\u043d\u043e\u0436\u043a\u0438. \u041c\u0435\u043b\u043a\u0438\u0439 \u0445\u0438\u0449\u043d\u0438\u043a \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Euglypha alveolata has a shell of silica scales. Thin filose pseudopodia. A small bacterial predator."},
  68:{ru:"Nebela collaris \u2014 \u0431\u0443\u0442\u044b\u043b\u043a\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u043a\u0430 \u0438\u0437 \u0447\u0443\u0436\u0438\u0445 \u0447\u0435\u0448\u0443\u0435\u043a. \u041b\u0435\u0441\u043d\u044b\u0435 \u0438 \u0431\u043e\u043b\u043e\u0442\u043d\u044b\u0435 \u0432\u043e\u0434\u044b.",en:"Nebela collaris is a bottle-shaped shell built from stolen scales. Forest and bog waters."},
  69:{ru:"Centropyxis aculeata \u2014 \u0434\u0438\u0441\u043a\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u0440\u0430\u043a\u043e\u0432\u0438\u043d\u043a\u0430 \u0441 \u0448\u0438\u043f\u0430\u043c\u0438. \u0423\u0441\u0442\u044c\u0435 \u0441\u043c\u0435\u0449\u0435\u043d\u043e. \u041f\u043e\u043b\u0437\u0451\u0442 \u043f\u043e \u0434\u0435\u0442\u0440\u0438\u0442\u0443.",en:"Centropyxis aculeata is a disc shell with spines. The aperture is offset. It crawls on detritus."},
  70:{ru:"Actinophrys sol \u2014 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u0438\u043a: \u0442\u043e\u043d\u043a\u0438\u0435 \u043b\u0443\u0447\u0438-\u0430\u043a\u0441\u043e\u043f\u043e\u0434\u0438\u0438 \u0442\u043e\u0440\u0447\u0430\u0442 \u0432\u043e \u0432\u0441\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u044b. \u041d\u0430 \u043b\u0443\u0447\u0430\u0445 \u043b\u0438\u043f\u043d\u0435\u0442 \u0434\u043e\u0431\u044b\u0447\u0430, \u043f\u043e\u0442\u043e\u043c \u0432\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044f.",en:"Actinophrys sol is a heliozoan: thin axopodia radiate all around. Prey sticks to the rays and is pulled in."},
  71:{ru:"Actinosphaerium eichhorni \u2014 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u043c\u043d\u043e\u0433\u043e\u044f\u0434\u0435\u0440\u043d\u044b\u0439 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u0438\u043a. \u0422\u0435 \u0436\u0435 \u043b\u0443\u0447\u0438, \u043d\u043e \u043a\u043b\u0435\u0442\u043a\u0430 \u0432 \u0440\u0430\u0437\u044b \u0431\u043e\u043b\u044c\u0448\u0435. \u0415\u0441\u0442 \u0438\u043d\u0444\u0443\u0437\u043e\u0440\u0438\u0439 \u0438 \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043e\u043a.",en:"Actinosphaerium eichhorni is a large multinucleate heliozoan. Same rays, much bigger cell. It eats ciliates and rotifers."},
  72:{ru:"Raphidiophrys pallida \u2014 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u0438\u043a \u0432 \u0447\u0435\u0448\u0443\u0439\u043a\u0430\u0445. \u041b\u0443\u0447\u0438 \u0441 \u043a\u0440\u0435\u043c\u043d\u0435\u0437\u0451\u043c\u043d\u044b\u043c\u0438 \u0438\u0433\u043b\u0430\u043c\u0438. \u0417\u0430\u0441\u0430\u0434\u043d\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a \u043f\u043b\u0430\u043d\u043a\u0442\u043e\u043d\u0430.",en:"Raphidiophrys pallida is a heliozoan in scales. Rays carry silica needles. An ambush plankton hunter."},
  73:{ru:"Rotaria rotatoria \u2014 \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043a\u0430, \u0443\u043c\u0435\u0435\u0442 \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u0432\u044b\u0441\u044b\u0445\u0430\u043d\u0438\u0435. \u041a\u043e\u043b\u043e\u0432\u0440\u0430\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0430\u043f\u043f\u0430\u0440\u0430\u0442 \u0433\u043e\u043d\u0438\u0442 \u0435\u0434\u0443 \u0432 \u0440\u043e\u0442. \u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u043c\u043d\u043e\u0433\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u0435.",en:"Rotaria rotatoria is a rotifer that can survive drying. A corona wheels food into the mouth. A true multicellular animal."},
  74:{ru:"Philodina roseola \u2014 \u0440\u043e\u0437\u043e\u0432\u0430\u044f \u0431\u0434\u0435\u043b\u043b\u043e\u0438\u0434\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043a\u0430. \u041f\u043e\u043b\u0437\u0430\u0435\u0442 \u043a\u0430\u043a \u043f\u0438\u044f\u0432\u043a\u0430 \u0438 \u043f\u043b\u0430\u0432\u0430\u0435\u0442. \u0422\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u043a\u0438, \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u0441\u0430\u043c\u0446\u043e\u0432.",en:"Philodina roseola is a pink bdelloid rotifer. It crawls like a leech and also swims. Females only; no males."},
  75:{ru:"Brachionus plicatilis \u2014 \u043f\u043b\u0430\u043d\u043a\u0442\u043e\u043d\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043a\u0430 \u0441 \u043f\u0430\u043d\u0446\u0438\u0440\u0435\u043c. \u041a\u043e\u0440\u043c \u0434\u043b\u044f \u043c\u0430\u043b\u044c\u043a\u043e\u0432 \u0432 \u0430\u043a\u0432\u0430\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0435. \u0424\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u0438 \u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439.",en:"Brachionus plicatilis is a planktonic loricate rotifer. Fry food in aquaculture. It filters algae and bacteria."},
  76:{ru:"Keratella cochlearis \u2014 \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043a\u0430 \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c \u0448\u0438\u043f\u043e\u043c \u043f\u0430\u043d\u0446\u0438\u0440\u044f. \u0428\u0438\u043f \u043c\u0435\u0448\u0430\u0435\u0442 \u0445\u0438\u0449\u043d\u0438\u043a\u0430\u043c. \u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u043f\u0440\u0443\u0434\u043e\u0432\u044b\u0439 \u043f\u043b\u0430\u043d\u043a\u0442\u043e\u043d.",en:"Keratella cochlearis is a rotifer with a long lorica spine. The spine deters predators. Common pond plankton."},
  77:{ru:"Asplanchna priodonta \u2014 \u043c\u0435\u0448\u043e\u043a \u0431\u0435\u0437 \u043f\u0430\u043d\u0446\u0438\u0440\u044f, \u0445\u0438\u0449\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043a\u0430. \u0413\u043b\u043e\u0442\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043a\u043e\u043b\u043e\u0432\u0440\u0430\u0442\u043e\u043a \u0438 \u0438\u043d\u0444\u0443\u0437\u043e\u0440\u0438\u0439 \u0446\u0435\u043b\u0438\u043a\u043e\u043c.",en:"Asplanchna priodonta is a sack without a lorica, a predatory rotifer. It swallows other rotifers and ciliates whole."},
  78:{ru:"Chaetonotus maximus \u2014 \u0431\u0440\u044e\u0445\u043e\u0440\u0435\u0441\u043d\u0438\u0447\u043d\u0430\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u0442\u0440\u0438\u0445\u0430. \u041f\u043e\u043a\u0440\u044b\u0442\u0430 \u0447\u0435\u0448\u0443\u0439\u043a\u0430\u043c\u0438, \u043f\u043e\u043b\u0437\u0430\u0435\u0442 \u043f\u043e \u0434\u043d\u0443. \u0415\u0441\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0438 \u0434\u0435\u0442\u0440\u0438\u0442.",en:"Chaetonotus maximus is a gastrotrich. Scale-covered, it crawls on the bottom. It eats bacteria and detritus."},
  79:{ru:"Lepidodermella squamata \u2014 \u043c\u0435\u043b\u043a\u0430\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u0442\u0440\u0438\u0445\u0430 \u0432 \u0447\u0435\u0440\u0435\u043f\u0438\u0446\u0435 \u0447\u0435\u0448\u0443\u0435\u043a. \u041e\u0447\u0435\u043d\u044c \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0440\u0430\u0437\u0432\u043e\u0440\u043e\u0442 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435.",en:"Lepidodermella squamata is a small gastrotrich in overlapping scales. Very fast in-place turns."},
  80:{ru:"Macrostomum lignano \u2014 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0447\u0435\u0440\u0432\u044c. \u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043c\u044b\u0448\u0446\u044b \u0438 \u0433\u043b\u0430\u0437\u0430. \u041c\u043e\u0434\u0435\u043b\u044c \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438. \u041e\u0445\u043e\u0442\u0438\u0442\u0441\u044f \u043d\u0430 \u043c\u0435\u043b\u043a\u0438\u0445 \u043f\u0440\u043e\u0442\u0438\u0441\u0442\u043e\u0432.",en:"Macrostomum lignano is a microscopic flatworm. Real muscles and eyes. A regeneration model. It hunts small protists."},
  81:{ru:"Stenostomum leucops \u2014 \u0442\u043e\u043d\u043a\u0438\u0439 \u0440\u0435\u0441\u043d\u0438\u0447\u043d\u044b\u0439 \u0447\u0435\u0440\u0432\u044c. \u0414\u0435\u043b\u0438\u0442\u0441\u044f \u043f\u043e\u043f\u0435\u0440\u0451\u043a \u0446\u0435\u043f\u043e\u0447\u043a\u043e\u0439 \u0437\u043e\u043e\u0438\u0434\u043e\u0432. \u0425\u0438\u0449\u043d\u0438\u043a \u0434\u0435\u0442\u0440\u0438\u0442\u0430 \u0438 \u043c\u0435\u043b\u043a\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445.",en:"Stenostomum leucops is a thin ciliated worm. It divides across into a chain of zooids. Predator of detritus and small animals."},
  82:{ru:"Microstomum lineare \u2014 \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0447\u0435\u0440\u0432\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0441\u0442 \u0433\u0438\u0434\u0440 \u0438 \u0432\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0438\u0445 \u0441\u0442\u0440\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u043b\u0435\u0442\u043a\u0438 \u0441\u0435\u0431\u0435 \u0432 \u043a\u043e\u0436\u0443. \u0426\u0435\u043f\u043e\u0447\u043a\u0430 \u0437\u043e\u043e\u0438\u0434\u043e\u0432.",en:"Microstomum lineare is a flatworm that eats hydra and embeds their stinging cells in its own skin. A chain of zooids."},
  83:{ru:"Prostoma graecense \u2014 \u043f\u0440\u0435\u0441\u043d\u043e\u0432\u043e\u0434\u043d\u0430\u044f \u043d\u0435\u043c\u0435\u0440\u0442\u0438\u043d\u0430. \u0414\u043b\u0438\u043d\u043d\u044b\u0439 \u0445\u043e\u0431\u043e\u0442 \u0432\u044b\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u0435\u0442 \u0432 \u0434\u043e\u0431\u044b\u0447\u0443. \u0420\u0435\u0434\u043a\u0438\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u043e\u0445\u043e\u0442\u043d\u0438\u043a \u0434\u043d\u0430.",en:"Prostoma graecense is a freshwater nemertean. A long proboscis shoots at prey. A rare large bottom hunter."},
  84:{ru:"Trichoplax adhaerens \u2014 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0447\u0430\u0442\u043e\u0435, \u043e\u0434\u043d\u043e \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u043c\u043d\u043e\u0433\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0445. \u041f\u043e\u043b\u0437\u0451\u0442 \u043f\u043b\u0430\u0441\u0442\u043e\u043c, \u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442 \u043f\u0438\u0449\u0443 \u0441\u043d\u0430\u0440\u0443\u0436\u0438. \u041d\u0435\u0442 \u0440\u0442\u0430.",en:"Trichoplax adhaerens is a placozoan, among the simplest animals. It crawls as a sheet and digests food outside. No mouth."},
  85:{ru:"Saccharomyces cerevisiae \u2014 \u043f\u0435\u043a\u0430\u0440\u0441\u043a\u0438\u0435 \u0434\u0440\u043e\u0436\u0436\u0438. \u041f\u043e\u0447\u043a\u0443\u044e\u0442\u0441\u044f, \u0435\u0434\u044f\u0442 \u0441\u0430\u0445\u0430\u0440, \u0432\u044b\u0434\u0435\u043b\u044f\u044e\u0442 CO2 \u0438 \u0441\u043f\u0438\u0440\u0442. \u0412 \u043f\u0440\u0443\u0434\u0443 \u2014 \u0443\u0431\u043e\u0440\u0449\u0438\u043a \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0451\u043d\u043d\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u043a\u0438.",en:"Saccharomyces cerevisiae is baker's yeast. It buds, eats sugar, releases CO2 and alcohol. In the pond it cleans dissolved organics."},
  86:{ru:"Candida albicans \u2014 \u0434\u0440\u043e\u0436\u0436\u0438, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0435 \u0440\u0430\u0441\u0442\u0438 \u043d\u0438\u0442\u044f\u043c\u0438. \u041e\u043f\u043f\u043e\u0440\u0442\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u0442\u043e\u0433\u0435\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u0412 \u0438\u0433\u0440\u0435 \u2014 \u0434\u0435\u0442\u0440\u0438\u0442\u043d\u044b\u0439 \u0433\u0440\u0438\u0431.",en:"Candida albicans is a yeast that can grow as filaments. An opportunistic human pathogen. In-game it is a detrital fungus."},
  87:{ru:"Mucor mucedo \u2014 \u043c\u0443\u043a\u043e\u0440, \u0445\u043b\u0435\u0431\u043d\u0430\u044f \u043f\u043b\u0435\u0441\u0435\u043d\u044c. \u0421\u043f\u043e\u0440\u0430\u043d\u0433\u0438\u0438 \u043d\u0430 \u043d\u043e\u0436\u043a\u0430\u0445, \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0440\u043e\u0441\u0442 \u043f\u043e \u043c\u0451\u0440\u0442\u0432\u043e\u043c\u0443. \u041d\u0435 \u043e\u0445\u043e\u0442\u0438\u0442\u0441\u044f \u043d\u0430 \u0436\u0438\u0432\u044b\u0445.",en:"Mucor mucedo is bread mold. Sporangia on stalks, fast growth over the dead. It does not hunt the living."},
  88:{ru:"Rhizopus stolonifer \u2014 \u0447\u0451\u0440\u043d\u0430\u044f \u0445\u043b\u0435\u0431\u043d\u0430\u044f \u043f\u043b\u0435\u0441\u0435\u043d\u044c. \u0421\u0442\u043e\u043b\u043e\u043d\u044b \u0438 \u0440\u0438\u0437\u043e\u0438\u0434\u044b \u0440\u0430\u0441\u043f\u043e\u043b\u0437\u0430\u044e\u0442\u0441\u044f \u043f\u043e \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442\u0443. \u0420\u0430\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u043a\u0440\u0430\u0445\u043c\u0430\u043b.",en:"Rhizopus stolonifer is black bread mold. Stolons and rhizoids spread over the substrate. It breaks down starch."},
  89:{ru:"Penicillium chrysogenum \u2014 \u043a\u0438\u0441\u0442\u0435\u0432\u0438\u043a, \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u0430. \u041a\u0438\u0441\u0442\u043e\u0447\u043a\u0438 \u043a\u043e\u043d\u0438\u0434\u0438\u0439. \u0420\u0430\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u043e\u0440\u0433\u0430\u043d\u0438\u043a\u0443 \u0438 \u0433\u043b\u0443\u0448\u0438\u0442 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0432\u043e\u043a\u0440\u0443\u0433.",en:"Penicillium chrysogenum is a brush mold, the source of penicillin. Conidial brushes. It decomposes organics and suppresses nearby bacteria."},
  90:{ru:"Aspergillus niger \u2014 \u0447\u0451\u0440\u043d\u044b\u0439 \u0430\u0441\u043f\u0435\u0440\u0433\u0438\u043b\u043b. \u0428\u0430\u0440\u043e\u0432\u0438\u0434\u043d\u044b\u0435 \u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0441\u043f\u043e\u0440. \u041f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u0446\u0435\u043d\u0442 \u043b\u0438\u043c\u043e\u043d\u043d\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u044b. \u0421\u0430\u043f\u0440\u043e\u0442\u0440\u043e\u0444.",en:"Aspergillus niger is black aspergillus. Spherical spore heads. Industrial citric-acid producer. A saprotroph."},
  91:{ru:"Batrachochytrium dendrobatidis \u2014 \u0445\u0438\u0442\u0440\u0438\u0434\u0438\u0435\u0432\u044b\u0439 \u0433\u0440\u0438\u0431 \u043b\u044f\u0433\u0443\u0448\u0435\u043a. \u0417\u043e\u043e\u0441\u043f\u043e\u0440\u044b \u0441 \u043e\u0434\u043d\u0438\u043c \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043c. \u0412 \u043f\u0440\u0443\u0434\u0443 \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u043e\u0434\u043d\u043e\u0433\u043e \u0433\u0440\u0438\u0431\u0430.",en:"Batrachochytrium dendrobatidis is a chytrid of frogs. Uniflagellate zoospores. In the pond it is a water-fungus model."},
  92:{ru:"Chytriomyces aureus \u2014 \u0432\u043e\u0434\u043d\u044b\u0439 \u0445\u0438\u0442\u0440\u0438\u0434 \u043d\u0430 \u043f\u044b\u043b\u044c\u0446\u0435 \u0438 \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u044f\u0445. \u0417\u043e\u043b\u043e\u0442\u0438\u0441\u0442\u044b\u0435 \u0441\u043f\u043e\u0440\u0430\u043d\u0433\u0438\u0438, \u0437\u043e\u043e\u0441\u043f\u043e\u0440\u044b \u043f\u043b\u044b\u0432\u0443\u0442 \u043a \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442\u0443.",en:"Chytriomyces aureus is a water chytrid on pollen and algae. Golden sporangia; zoospores swim to the substrate."},
  93:{ru:"Allomyces macrogynus \u2014 \u0432\u043e\u0434\u043d\u044b\u0439 \u0433\u0440\u0438\u0431 \u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043c\u0438\u0446\u0435\u043b\u0438\u0435\u043c. \u0427\u0435\u0440\u0435\u0434\u0443\u0435\u0442 \u0434\u0438\u043f\u043b\u043e\u0438\u0434 \u0438 \u0433\u0430\u043f\u043b\u043e\u0438\u0434. \u0417\u043e\u043e\u0441\u043f\u043e\u0440\u044b \u0441 \u0437\u0430\u0434\u043d\u0438\u043c \u0436\u0433\u0443\u0442\u0438\u043a\u043e\u043c.",en:"Allomyces macrogynus is a water fungus with true mycelium. It alternates diploid and haploid. Zoospores have a posterior flagellum."},
  94:{ru:"Bacillus subtilis \u2014 \u043f\u043e\u0447\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u0430\u043b\u043e\u0447\u043a\u0430. \u0421\u043f\u043e\u0440\u044b \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044e\u0442 \u043a\u0438\u043f\u044f\u0442\u043e\u043a. \u0420\u0430\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u0431\u0435\u043b\u043e\u043a, \u043c\u043e\u0434\u0435\u043b\u044c \u0433\u0440\u0430\u043c\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445.",en:"Bacillus subtilis is a soil rod. Spores survive boiling. It breaks down protein; a Gram-positive model."},
  95:{ru:"Pseudomonas putida \u2014 \u043f\u0430\u043b\u043e\u0447\u043a\u0430-\u0443\u0431\u043e\u0440\u0449\u0438\u043a. \u0415\u0441\u0442 \u0434\u0430\u0436\u0435 \u043d\u0435\u0444\u0442\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b. \u041f\u043e\u0434\u0432\u0438\u0436\u043d\u044b\u0439 \u0436\u0433\u0443\u0442\u0438\u043a, \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0440\u043e\u0441\u0442 \u043d\u0430 \u0434\u0435\u0442\u0440\u0438\u0442\u0435.",en:"Pseudomonas putida is a cleanup rod. It even eats petroleum products. Motile flagellum, fast growth on detritus."},
  96:{ru:"Streptomyces coelicolor \u2014 \u043d\u0438\u0442\u0447\u0430\u0442\u0430\u044f \u043f\u043e\u0447\u0432\u0435\u043d\u043d\u0430\u044f \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f. \u0414\u0430\u0451\u0442 \u0437\u0430\u043f\u0430\u0445 \u0437\u0435\u043c\u043b\u0438 (\u0433\u0435\u043e\u0441\u043c\u0438\u043d) \u0438 \u043a\u0443\u0447\u0443 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432. \u0421\u043f\u043e\u0440\u044b \u043d\u0430 \u0433\u0438\u0444\u0430\u0445.",en:"Streptomyces coelicolor is a filamentous soil bacterium. It makes the smell of earth (geosmin) and many antibiotics. Spores on hyphae."},
  97:{ru:"Cellulomonas fimi \u2014 \u0440\u0430\u0437\u043b\u0430\u0433\u0430\u0435\u0442 \u0446\u0435\u043b\u043b\u044e\u043b\u043e\u0437\u0443. \u0416\u0451\u043b\u0442\u0430\u044f \u043f\u0430\u043b\u043e\u0447\u043a\u0430 \u043d\u0430 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u0434\u0435\u0442\u0440\u0438\u0442\u0435. \u0411\u0435\u0437 \u043d\u0435\u0451 \u043c\u0451\u0440\u0442\u0432\u044b\u0435 \u0432\u043e\u0434\u043e\u0440\u043e\u0441\u043b\u0438 \u043b\u0435\u0436\u0430\u043b\u0438 \u0431\u044b \u0434\u043e\u043b\u044c\u0448\u0435.",en:"Cellulomonas fimi breaks down cellulose. A yellow rod on plant detritus. Without it dead algae would linger longer."},
  98:{ru:"Thermus aquaticus \u2014 \u0442\u0435\u0440\u043c\u043e\u0444\u0438\u043b \u0438\u0437 \u0433\u043e\u0440\u044f\u0447\u0438\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432. \u0424\u0435\u0440\u043c\u0435\u043d\u0442 Taq-\u043f\u043e\u043b\u0438\u043c\u0435\u0440\u0430\u0437\u0430 \u2014 \u043e\u0441\u043d\u043e\u0432\u0430 \u041f\u0426\u0420. \u0412 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u043c \u043f\u0440\u0443\u0434\u0443 \u043f\u043e\u0447\u0442\u0438 \u0441\u043f\u0438\u0442.",en:"Thermus aquaticus is a thermophile from hot springs. Taq polymerase is the basis of PCR. In a cold pond it is almost dormant."},
  99:{ru:"Deinococcus radiodurans \u2014 \u0447\u0435\u043c\u043f\u0438\u043e\u043d \u043f\u043e \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438. \u0421\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u0439 \u0433\u0435\u043d\u043e\u043c \u0437\u0430 \u0447\u0430\u0441\u044b. \u0422\u043e\u043b\u0441\u0442\u0430\u044f \u0441\u0442\u0435\u043d\u043a\u0430, \u0442\u0435\u0442\u0440\u0430\u0434\u044b \u043a\u043b\u0435\u0442\u043e\u043a.",en:"Deinococcus radiodurans is the radiation champion. It reassembles a shattered genome in hours. Thick wall, cell tetrads."},
  "T4 Bacteriophage":{ru:"T4 \u2014 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u043c\u0438\u043e\u0432\u0438\u0440\u0443\u0441 \u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0439 \u043f\u0430\u043b\u043e\u0447\u043a\u0438. \u0425\u0432\u043e\u0441\u0442 \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0438 \u0432\u043f\u0440\u044b\u0441\u043a\u0438\u0432\u0430\u0435\u0442 \u0414\u041d\u041a. \u0427\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0447\u0430\u0441\u0430 \u043a\u043b\u0435\u0442\u043a\u0430 \u043b\u043e\u043f\u0430\u0435\u0442\u0441\u044f, \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0444\u0430\u0433\u043e\u0432.",en:"T4 is a large myovirus of E. coli. The tail contracts and injects DNA. In half an hour the cell bursts and dozens of phages exit."},
  "Lambda Phage":{ru:"\u041b\u044f\u043c\u0431\u0434\u0430 \u2014 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0444\u0430\u0433. \u041c\u043e\u0436\u0435\u0442 \u0432\u0441\u0442\u0440\u043e\u0438\u0442\u044c\u0441\u044f \u0432 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u0443 \u0438 \u0441\u043f\u0430\u0442\u044c (\u043b\u0438\u0437\u043e\u0433\u0435\u043d\u0438\u044f) \u0438\u043b\u0438 \u0441\u0440\u0430\u0437\u0443 \u0440\u0435\u0437\u0430\u0442\u044c \u043a\u043b\u0435\u0442\u043a\u0443 (\u043b\u0438\u0437\u0438\u0441).",en:"Lambda is a temperate phage. It can insert into the chromosome and sleep (lysogeny) or cut the cell at once (lysis)."},
  "T7 Bacteriophage":{ru:"T7 \u2014 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0445\u0432\u043e\u0441\u0442, \u043e\u0447\u0435\u043d\u044c \u0431\u044b\u0441\u0442\u0440\u0430\u044f \u0440\u0435\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u044f. \u041b\u044e\u0431\u0438\u043c\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0438.",en:"T7 has a short tail and very fast replication. A favourite system in synthetic biology."},
  "Phi-6 Phage":{ru:"Phi-6 \u2014 \u0420\u041d\u041a-\u0444\u0430\u0433 \u0441 \u043b\u0438\u043f\u0438\u0434\u043d\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u043e\u0439. \u0417\u0430\u0440\u0430\u0436\u0430\u0435\u0442 \u043f\u0441\u0435\u0432\u0434\u043e\u043c\u043e\u043d\u0430\u0434. \u0420\u0435\u0434\u043a\u0430\u044f \u0434\u043b\u044f \u0444\u0430\u0433\u043e\u0432 \u043c\u0435\u043c\u0431\u0440\u0430\u043d\u0430.",en:"Phi-6 is an RNA phage with a lipid envelope. It infects Pseudomonas. A rare membrane for a phage."},
  "MS2 Phage":{ru:"MS2 \u2014 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u0439 \u0420\u041d\u041a-\u0444\u0430\u0433 \u0431\u0435\u0437 \u0445\u0432\u043e\u0441\u0442\u0430. \u0421\u0430\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043f\u0438\u043b\u0438 \u0441\u0430\u043c\u0446\u043e\u0432 E. coli. \u0413\u0435\u043d\u043e\u043c \u2014 \u043e\u0434\u043d\u0430 \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0445 \u0420\u041d\u041a.",en:"MS2 is a tiny tailless RNA phage. It binds male E. coli pili. Its genome was one of the first RNA genomes read."},
  "Neuro-Parasite":{ru:"\u0412\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0439 \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0440\u0430\u0437\u0438\u0442 \u043f\u0440\u0443\u0434\u0430. \u0426\u0435\u043f\u043b\u044f\u0435\u0442\u0441\u044f \u043a \u044d\u0443\u043a\u0430\u0440\u0438\u043e\u0442\u0430\u043c \u0438 \u043b\u043e\u043c\u0430\u0435\u0442 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0445\u043e\u0437\u044f\u0438\u043d\u0430, \u043f\u043e\u043a\u0430 \u0442\u043e\u0442 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u0440\u0430\u0437\u043d\u043e\u0441\u0447\u0438\u043a\u043e\u043c.",en:"A fictional pond neuro-parasite. It latches onto eukaryotes and breaks host behaviour until the host becomes a carrier."},
  1001:{ru:"Sexual Eukaryote \u2014 \u0443\u0447\u0435\u0431\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f. \u0414\u0432\u0430 \u043f\u043e\u043b\u0430, \u0441\u043b\u0438\u044f\u043d\u0438\u0435 \u0433\u0430\u043c\u0435\u0442, \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u0434\u0432\u043e\u0435.",en:"Sexual Eukaryote is a teaching model of sexual reproduction. Two sexes, gamete fusion, not simple binary fission."},
  "Sexual Eukaryote":{ru:"Sexual Eukaryote \u2014 \u0443\u0447\u0435\u0431\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f. \u0414\u0432\u0430 \u043f\u043e\u043b\u0430, \u0441\u043b\u0438\u044f\u043d\u0438\u0435 \u0433\u0430\u043c\u0435\u0442, \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u0434\u0432\u043e\u0435.",en:"Sexual Eukaryote is a teaching model of sexual reproduction. Two sexes, gamete fusion, not simple binary fission."},
